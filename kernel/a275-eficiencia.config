# Fragmento de configuración del kernel para la ThinkPad A275 (AMD Bristol Ridge).
# Se aplica sobre un .config ya existente (por ejemplo tras 'make localmodconfig'):
#
#   scripts/kconfig/merge_config.sh .config /ruta/a/kernel/a275-eficiencia.config
#
# Pensado para 6.12 o posterior. La idea no es fijar una política, sino compilar
# TODOS los interruptores para poder conmutarlos en caliente y medir.
# Las opciones que no existan en tu versión se ignoran con un aviso de merge_config.

# ---------------------------------------------------------------------------
# CPU AMD familia 15h: frecuencia, reposo, medición de potencia
# ---------------------------------------------------------------------------
CONFIG_CPU_SUP_AMD=y
CONFIG_AMD_NB=y
CONFIG_X86_AMD_PLATFORM_DEVICE=y
CONFIG_MICROCODE=y
CONFIG_X86_MSR=y
CONFIG_X86_CPUID=y
CONFIG_AMD_IOMMU=y

CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_X86_ACPI_CPUFREQ_CPB=y
CONFIG_X86_AMD_FREQ_SENSITIVITY=m
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
# amd_pstate no aplica (sin CPPC); se deja fuera para no confundir.
# CONFIG_X86_AMD_PSTATE is not set

CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_CPU_IDLE_GOV_TEO=y
CONFIG_CPU_IDLE_GOV_LADDER=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_PROCESSOR_AGGREGATOR=m

# Potencia del paquete en Bristol Ridge (ACC_POWER): hwmon y perf
CONFIG_HWMON=y
CONFIG_SENSORS_FAM15H_POWER=m
CONFIG_SENSORS_K10TEMP=m
CONFIG_PERF_EVENTS=y
CONFIG_PERF_EVENTS_AMD_POWER=m
CONFIG_PERF_EVENTS_AMD_UNCORE=m

# ---------------------------------------------------------------------------
# Planificador, preempción y tick
# ---------------------------------------------------------------------------
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_PREEMPT=y
CONFIG_HZ_250=y
CONFIG_HZ=250
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_SCHEDSTATS=y
CONFIG_SCHED_DEBUG=y

# sched_ext: planificadores en BPF cargables en caliente (scx_lavd, scx_bpfland...)
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_EVENTS=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SCHED_CLASS_EXT=y

# ---------------------------------------------------------------------------
# cgroups y PSI: la señal de "ciclos perdidos" y el mando por aplicación
# ---------------------------------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set

# ---------------------------------------------------------------------------
# Memoria: jerarquía RAM / RAM comprimida / SSD, y el monitor de accesos
# ---------------------------------------------------------------------------
CONFIG_SWAP=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_SHRINKER_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZ4=y
CONFIG_ZSWAP_ZPOOL_DEFAULT_ZSMALLOC=y
CONFIG_ZSMALLOC=y
CONFIG_ZSMALLOC_STAT=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZ4HC=y
CONFIG_CRYPTO_LZO=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_DEFLATE=y

# zram como alternativa a zswap (con recompresión de páginas inactivas)
CONFIG_ZRAM=m
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZRAM_TRACK_ENTRY_ACTIME=y

# MGLRU
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_LRU_GEN_STATS=y

# DAMON: monitor de accesos y esquemas (DAMOS) con goals
CONFIG_DAMON=y
CONFIG_DAMON_VADDR=y
CONFIG_DAMON_PADDR=y
CONFIG_DAMON_SYSFS=y
CONFIG_DAMON_RECLAIM=y
CONFIG_DAMON_LRU_SORT=y

# Deduplicación, seguimiento de páginas inactivas, huge pages solo bajo madvise
CONFIG_KSM=y
CONFIG_PAGE_IDLE_FLAG=y
CONFIG_IDLE_PAGE_TRACKING=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_COMPACTION=y
CONFIG_PROC_PAGE_MONITOR=y
CONFIG_MEMCG_V1=n

# ---------------------------------------------------------------------------
# Gráficos: amdgpu con Display Core para Carrizo (GCN 3 / GFX8)
# ---------------------------------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_AMD_ACP=y
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_DRM_FBDEV_EMULATION=y
# Sin SI/CIK: esta iGPU es VI (GFX8) y amdgpu la coge por defecto
# CONFIG_DRM_AMDGPU_SI is not set
# CONFIG_DRM_AMDGPU_CIK is not set
# CONFIG_DRM_RADEON is not set

# ---------------------------------------------------------------------------
# Almacenamiento y PCIe
# ---------------------------------------------------------------------------
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_HWMON=y
CONFIG_SATA_AHCI=y
CONFIG_SATA_MOBILE_LPM_POLICY=3
CONFIG_PCIEASPM=y
CONFIG_PCIEASPM_DEFAULT=y
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_KYBER=m
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_MQ=y

# Sistemas de archivos con compresión (para páginas de fichero, que zswap no toca)
CONFIG_BTRFS_FS=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_F2FS_FS_LZO=y

# ---------------------------------------------------------------------------
# Plataforma ThinkPad y energía
# ---------------------------------------------------------------------------
CONFIG_ACPI=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_VIDEO=m
CONFIG_ACPI_PLATFORM_PROFILE=m
CONFIG_THINKPAD_ACPI=m
CONFIG_THINKPAD_ACPI_VIDEO=y
CONFIG_THINKPAD_ACPI_HOTKEY_POLL=y
CONFIG_SUSPEND=y
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_POWER_SUPPLY=y
CONFIG_POWERCAP=y

# ---------------------------------------------------------------------------
# Trazado y medición (sin los tracers de latencia que añaden sobrecarga fija)
# ---------------------------------------------------------------------------
CONFIG_DEBUG_FS=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_SCHED_TRACER=y
CONFIG_HIST_TRIGGERS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# CONFIG_IRQSOFF_TRACER is not set
# CONFIG_PREEMPT_TRACER is not set
# CONFIG_LATENCYTOP is not set
